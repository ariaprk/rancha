{
  "name": "rancha",
  "version": "1.1.1",
  "description": "A personal digital library and launcher",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "node-unrar-js": "2.0.2",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "electron-builder": "26.18.0"
  },
  "author": "Aria Sama",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.rancha.app",
    "productName": "Rancha",
    "copyright": "Copyright \u00a9 2026 Aria Sama",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon-256.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "node_modules/node-unrar-js/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Rancha-${version}-windows-setup.${ext}"
    },
    "portable": {
      "artifactName": "Rancha-${version}-windows-portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "pacman"
      ],
      "category": "Utility",
      "executableName": "rancha",
      "artifactName": "Rancha-${version}-linux-${arch}.${ext}"
    },
    "pacman": {
      "compression": "zstd",
      "maintainer": "Aria Sama",
      "synopsis": "A personal digital library and launcher",
      "artifactName": "Rancha-${version}-linux-x86_64.pkg.tar.zst",
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libxss",
        "libxtst",
        "libnotify",
        "libsecret",
        "xdg-utils"
      ]
    }
  }
}
